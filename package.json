{
  "name": "oremetrix",
  "version": "0.1.0",
  "private": true,
  "description": "OREMETRIX — protótipo de medição online da umidade de minério de ferro (TCC SENAI)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sim": "tsx scripts/simulator.ts",
    "sim:alert": "tsx scripts/simulator.ts --scenario=alert",
    "sim:fast": "tsx scripts/simulator.ts --fast",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0 || ^12.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
